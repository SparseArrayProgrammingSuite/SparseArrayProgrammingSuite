{
  "// saps_dir": "Directory where SAPS stores outputs and machine files",
  "saps_dir": ".saps",

  "branches": ["HEAD"],
  "environment_type": "virtualenv",
  "install_command": ["in-dir={env_dir} python -mpip install {build_dir} --force-reinstall"],
  "env_dir": ".saps/env",
    "results_dir": ".saps/env",

  "matrix": {
    "req": {
      "numpy": ["2.3"],
      "scipy": ["1.16.2"],
      "sparse": ["0.17.0"],
      "lark": ["1.3.0"],
      "ssgetpy": ["1.0rc2"]
    },
    "env_nobuild": {
      "SAPS_FRAMEWORK": [
        "frameworks/saps_numpy.py",
        "frameworks/saps_scipy.py",
        "frameworks/saps_sparse.py"
      ]
    }
  }
}
