{
  "//": "Competition config using ASV-native include entries. Each include is one competitor environment with its own dependencies.",
  "// SAPS_DEVICE": "Add \"SAPS_DEVICE\": \"gpu\" to a framework's env_nobuild to run it in the GPU array of scripts/submit-competition.sh (saps_pytorch.py then uses CUDA). Without it, frameworks run in the CPU array.",
  "// SAPS_FRAMEWORK_NAME": "Required and unique per include: the framework's name in combined results. One framework file can appear more than once (PyTorch runs on both CPU and GPU).",
  "environment_type": "virtualenv",
  "// nvidia-*-cu12": "CuPy's PyPI wheel needs the CUDA libraries installed separately. cupy-cuda12x[ctk] would install them, but ASV drops pip extras, so the cupy include lists those wheels itself, at the CUDA 12.6 versions of PyTorch's cu126 build, which runs on these V100s.",
  "// install_command": "install_editable_git.py installs a framework from a git checkout when its include sets SAPS_EDITABLE_GIT in env (env, unlike env_nobuild, reaches install commands); warm_julia_env.py starts Julia once for finch and galley. Both do nothing in other environments.",
  "install_command": [
    "in-dir={env_dir} python -mpip install {build_dir}",
    "in-dir={env_dir} python {build_dir}/scripts/install_editable_git.py",
    "in-dir={env_dir} python {build_dir}/scripts/warm_julia_env.py"
  ],
  "// install_timeout": "Seconds for each install command. warm_julia_env.py installs and precompiles Julia for finch and galley, which takes longer than ASV's 600 s default.",
  "install_timeout": 3600,
  "process_timeout": 240,
  "measurement_timeout": 180,
  "rounds": 1,
  "resume": true,
  "metrics": ["time"],
  "tag": ["suite-standard"],
  "saps_dir": "competition/run_local/task_0",
  "env_dir": "competition/run_local/task_0/env",
  "results_dir": "competition/run_local/task_0/results",
  "matrix": {},
  "exclude": [
    {
      "env_nobuild": {
        "SAPS_FRAMEWORK": null
      }
    }
  ],
